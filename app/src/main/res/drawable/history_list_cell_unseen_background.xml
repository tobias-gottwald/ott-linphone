<?xml version="1.0" encoding="utf-8"?>
<!-- OTT: resting background for call history rows that are still in the
     location's shared unseen set (same condition as the bold name).
     Pressed/selected/hovered keep the normal highlight so selection and
     touch feedback stay visible on unseen rows too. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"
        android:drawable="@drawable/color_main2_100" />
    <item android:state_pressed="true"
        android:drawable="@drawable/color_main2_100" />
    <item android:state_hovered="true"
        android:drawable="@drawable/color_main2_100" />
    <item
        android:drawable="@drawable/history_list_cell_unseen_color" />
</selector>
